# NaCCER R&D Evaluation Copilot - Backend Environment Configuration

PROJECT_NAME=naccer-rd-evaluation-backend
VERSION=1.0.0-p0.1
APP_ENV=development
API_V1_PREFIX=/api/v1

# Development Database URL (Local PostgreSQL)
DATABASE_URL=postgresql+psycopg://naccer:naccerpass@localhost:5432/naccer_db

# Production Database URL Placeholder (Supabase PostgreSQL):
# DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require

# Allowed CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://researchlens-lilac.vercel.app"]
